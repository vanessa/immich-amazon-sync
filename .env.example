# Immich

IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=your_immich_api_key

# Comma-separated album names (must match exactly as shown in Immich)
IMMICH_ALBUMS=Family,Vacation 2024

# Amazon Photos cookies
#
# These come from your browser after logging in to Amazon Photos.
#
# 1. Go to https://www.amazon.com/photos (or your regional TLD)
# 2. Open DevTools → Application → Cookies → https://www.amazon.com
# 3. Copy the values below.
#
# The cookie key names vary by region:
#   US accounts:     ubid-main, at-main
#   Brazil accounts: ubid-acbbr, at-acbbr
#   UK accounts:     ubid-acbuk, at-acbuk
#   etc.
#
# IMPORTANT: The at-* cookie is HttpOnly. You may need to grab it from
# DevTools → Network tab → any request to amazon.com → Cookie header.
# Cookies expire periodically (weeks to months) and must be refreshed manually.

AP_SESSION_ID=your_session_id

AP_UBID_KEY=ubid-main
AP_UBID_VALUE=your_ubid_value

AP_AT_KEY=at-main
AP_AT_VALUE=your_at_value
